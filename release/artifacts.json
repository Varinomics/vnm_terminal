{
  "schema": 1,
  "artifacts": [
    {
      "id": "source",
      "name": "vnm-terminal-source"
    },
    {
      "id": "windows_unsigned",
      "name": "vnm-terminal-windows-x64-unsigned"
    },
    {
      "id": "windows_signing_payload",
      "name": "vnm-terminal-windows-x64-signing-payload"
    },
    {
      "id": "windows_installer_engine",
      "name": "vnm-terminal-windows-installer-engine"
    },
    {
      "id": "windows_installer_source",
      "name": "vnm-terminal-windows-installer-source"
    },
    {
      "id": "windows_signed",
      "name": "vnm-terminal-windows-x64-signed"
    },
    {
      "id": "linux",
      "name": "vnm-terminal-linux-x64"
    },
    {
      "id": "macos_custom_titlebar_evidence",
      "name": "vnm-terminal-macos-custom-titlebar-evidence"
    },
    {
      "id": "macos_x64",
      "name_template": "vnm_terminal_v{version}_macos_x64_unnotarized",
      "name_expressions": [
        "${{ needs.resolve-dependencies.outputs[format('macos_{0}_artifact_name', matrix.architecture)] }}"
      ],
      "prune_pattern": "^vnm_terminal_v.*_macos_x64"
    },
    {
      "id": "macos_arm64",
      "name_template": "vnm_terminal_v{version}_macos_arm64_unnotarized",
      "name_expressions": [
        "${{ needs.resolve-dependencies.outputs[format('macos_{0}_artifact_name', matrix.architecture)] }}"
      ],
      "prune_pattern": "^vnm_terminal_v.*_macos_arm64"
    }
  ]
}
