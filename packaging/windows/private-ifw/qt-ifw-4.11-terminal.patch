+class Terminal_wizard_spacing : public QObject
+{
+public:
+    explicit Terminal_wizard_spacing(QWizard* wizard)
+
+    :
+        QObject(wizard),
+        m_wizard(wizard)
+    {
+        m_wizard->installEventFilter(this);
+        connect(m_wizard, &QWizard::currentIdChanged, this, [this] { apply_spacing(); });
+    }
+
+protected:
+    bool eventFilter(QObject*, QEvent* event) override
+    {
+        if (event->type() == QEvent::Show || event->type() == QEvent::LayoutRequest) {
+            apply_spacing();
+        }
+        return false;
+    }
+
+private:
+    void apply_spacing()
+    {
+        auto* page = m_wizard->currentPage();
+        auto* side = m_wizard->sideWidget();
+        if (!page || !side || side->parentWidget() == m_wizard) {
+            return;
+        }
+        // Modern QWizard nests page and sidebar layouts with independent margins.
+        // Use the button row's native outer margin once at each content boundary.
+        const int margin = m_wizard->style()->pixelMetric(QStyle::PM_LayoutRightMargin, nullptr, m_wizard);
+        auto* page_frame = page->parentWidget();
+        auto* side_frame = side->parentWidget();
+        page_frame->installEventFilter(this);
+        side_frame->installEventFilter(this);
+        page_frame->setContentsMargins(margin, 0, margin, 0);
+        page_frame->layout()->setContentsMargins(0, 0, 0, 0);
+        page->layout()->setContentsMargins(0, margin, 0, margin);
+        if (qobject_cast<LicenseAgreementPage*>(page)) {
+            page->layout()->setSpacing(margin);
+        }
+        side_frame->layout()->setContentsMargins(margin, margin, 0, margin);
+    }
+
+    QWizard* m_wizard;
+};
+
+}
+#endif
