# IFW is a static auxiliary application. Keep its SDK independent of the
# dynamically linked Qt deployment used by vnm_terminal itself.
set(CMAKE_BUILD_TYPE Release CACHE STRING "Build configuration" FORCE)
set(CMAKE_FASTBUILD_CAPTURE_SYSTEM_ENV OFF CACHE BOOL "Do not capture environment" FORCE)
set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT "" CACHE STRING "No Release debug data" FORCE)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded CACHE STRING "Static Release CRT" FORCE)
set(CMAKE_C_FLAGS_RELEASE "/O2 /Ob2 /DNDEBUG" CACHE STRING "Release C flags" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "/O2 /Ob2 /DNDEBUG" CACHE STRING "Release C++ flags" FORCE)
foreach(kind EXE SHARED MODULE)
    set(CMAKE_${kind}_LINKER_FLAGS_RELEASE "/INCREMENTAL:NO /DEBUG:NONE /NOCOFFGRPINFO"
        CACHE STRING "Release linker flags" FORCE)
endforeach()
set(BUILD_SHARED_LIBS OFF CACHE BOOL "Static libraries" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "No dependency tests" FORCE)
set(QT_BUILD_TESTS OFF CACHE BOOL "No dependency tests" FORCE)
set(QT_BUILD_EXAMPLES OFF CACHE BOOL "No dependency examples" FORCE)
set(QT_BUILD_BENCHMARKS OFF CACHE BOOL "No dependency benchmarks" FORCE)
# Direct CMake configuration has no configure.bat-generated config.opt to install.
set(QT_INSTALL_CONFIG_INFO_FILES OFF CACHE BOOL "No configure wrapper metadata" FORCE)
set(QT_INTERNAL_AVOID_OVERRIDING_SYNCQT_CONFIG ON CACHE BOOL "Release syncqt" FORCE)
set(QT_USE_CCACHE OFF CACHE BOOL "No compiler launcher" FORCE)
set(QT_USE_VCPKG OFF CACHE BOOL "Use locked sources" FORCE)
set(FEATURE_static_runtime ON CACHE BOOL "Static Release CRT" FORCE)
set(FEATURE_force_debug_info OFF CACHE BOOL "No debug data" FORCE)
set(FEATURE_separate_debug_info OFF CACHE BOOL "No separate debug data" FORCE)
set(FEATURE_msvc_obj_debug_info OFF CACHE BOOL "No object debug data" FORCE)
set(FEATURE_qml_debug OFF CACHE BOOL "No QML debugging" FORCE)
set(FEATURE_openssl OFF CACHE BOOL "Use Windows TLS" FORCE)
set(FEATURE_schannel ON CACHE BOOL "Use Windows TLS" FORCE)
set(QT_BUILD_SUBMODULES "qtbase;qtdeclarative;qttools;qt5compat;qttranslations"
    CACHE STRING "Installer modules" FORCE)
foreach(module qtimageformats qtlanguageserver qtshadertools qtsvg)
    set(BUILD_${module} OFF CACHE BOOL "Not used by the installer" FORCE)
endforeach()
foreach(feature assistant designer distancefieldgenerator pixeltool qdoc qdbus
        qev qtattributionsscanner qtdiag qtplugininfo)
    set(FEATURE_${feature} OFF CACHE BOOL "Not used by the installer" FORCE)
endforeach()
foreach(tool XZ XZDEC LZMADEC LZMAINFO)
    set(XZ_TOOL_${tool} OFF CACHE BOOL "Only liblzma is required" FORCE)
endforeach()
set(XZ_NLS OFF CACHE BOOL "No compression command-line tools" FORCE)
