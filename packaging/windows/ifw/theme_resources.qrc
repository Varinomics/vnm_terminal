<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/installer-theme">
        <file>checkbox_check.png</file>
        <file>checkbox_check@2x.png</file>
        <file>radio_dot.png</file>
        <file>radio_dot@2x.png</file>
        <file>combo_arrow.png</file>
        <file>combo_arrow@2x.png</file>
        <file>log_path_probe.ps1</file>
        <file>replacement_support.ps1</file>
    </qresource>
    <qresource prefix="/installer-config">
        <file alias="varinomics_logo_png@2x." compression-algorithm="none">varinomics_logo@2x.png</file>
    </qresource>
</RCC>
