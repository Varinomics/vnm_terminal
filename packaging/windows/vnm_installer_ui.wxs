<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- This keeps the standard WiX InstallDir navigation and maintenance
             lifecycle, but gives the three user-facing integrations ordinary
             checkboxes. The AddLocal/Remove control events update the same MSI
             features used by silent install, repair, upgrade, and uninstall. -->
        <UI Id="VnmTerminalInstallerUI">
            <TextStyle Id="WixUI_Font_Normal"
                FaceName="Tahoma"
                Size="8"/>
            <TextStyle Id="WixUI_Font_Bigger"
                FaceName="Tahoma"
                Size="12"/>
            <TextStyle Id="WixUI_Font_Title"
                FaceName="Tahoma"
                Size="9"
                Bold="yes"/>

            <Property Id="DefaultUIFont"
                Value="WixUI_Font_Normal"/>
            <Property Id="WixUI_Mode"
                Value="InstallDir"/>

            <DialogRef Id="BrowseDlg"/>
            <DialogRef Id="DiskCostDlg"/>
            <DialogRef Id="ErrorDlg"/>
            <DialogRef Id="FatalError"/>
            <DialogRef Id="FilesInUse"/>
            <DialogRef Id="InstallDirDlg"/>
            <DialogRef Id="MsiRMFilesInUse"/>
            <DialogRef Id="PrepareDlg"/>
            <DialogRef Id="ProgressDlg"/>
            <DialogRef Id="ResumeDlg"/>
            <DialogRef Id="UserExit"/>

            <Dialog Id="VnmTerminalOptionsDlg"
                Width="370"
                Height="270"
                Title="[ProductName] Setup">
                <Control Id="Next"
                    Type="PushButton"
                    X="236"
                    Y="243"
                    Width="56"
                    Height="17"
                    Default="yes"
                    Text="Next"/>
                <Control Id="Back"
                    Type="PushButton"
                    X="180"
                    Y="243"
                    Width="56"
                    Height="17"
                    Text="Back"/>
                <Control Id="Cancel"
                    Type="PushButton"
                    X="304"
                    Y="243"
                    Width="56"
                    Height="17"
                    Cancel="yes"
                    Text="Cancel">
                    <Publish Event="SpawnDialog"
                        Value="CancelDlg">1</Publish>
                </Control>

                <Control Id="Description"
                    Type="Text"
                    X="25"
                    Y="23"
                    Width="300"
                    Height="15"
                    Transparent="yes"
                    NoPrefix="yes"
                    Text="Choose how vnm_terminal is integrated with Windows."/>
                <Control Id="Title"
                    Type="Text"
                    X="15"
                    Y="6"
                    Width="220"
                    Height="15"
                    Transparent="yes"
                    NoPrefix="yes"
                    Text="Installation options"/>
                <Control Id="BannerBitmap"
                    Type="Bitmap"
                    X="0"
                    Y="0"
                    Width="370"
                    Height="44"
                    TabSkip="no"
                    Text="WixUI_Bmp_Banner"/>
                <Control Id="BannerLine"
                    Type="Line"
                    X="0"
                    Y="44"
                    Width="370"
                    Height="0"/>
                <Control Id="BottomLine"
                    Type="Line"
                    X="0"
                    Y="234"
                    Width="370"
                    Height="0"/>

                <Control Id="Intro"
                    Type="Text"
                    X="25"
                    Y="60"
                    Width="320"
                    Height="20"
                    NoPrefix="yes"
                    Text="Select the shortcuts and command-line access you want:"/>
                <Control Id="StartMenuCheckBox"
                    Type="CheckBox"
                    X="35"
                    Y="88"
                    Width="310"
                    Height="18"
                    CheckBoxValue="1"
                    Property="VnmTerminalStartMenuSelected"
                    Text="Create Start Menu shortcuts"/>
                <Control Id="SystemPathCheckBox"
                    Type="CheckBox"
                    X="35"
                    Y="120"
                    Width="310"
                    Height="18"
                    CheckBoxValue="1"
                    Property="VnmTerminalSystemPathSelected"
                    Text="Add vnm_terminal to the system PATH"/>
                <Control Id="SystemPathNote"
                    Type="Text"
                    X="52"
                    Y="139"
                    Width="290"
                    Height="24"
                    NoPrefix="yes"
                    Text="Lets you start vnm_terminal from a command prompt. Requires the default Program Files location."/>
                <Control Id="DesktopCheckBox"
                    Type="CheckBox"
                    X="35"
                    Y="174"
                    Width="310"
                    Height="18"
                    CheckBoxValue="1"
                    Property="VnmTerminalDesktopSelected"
                    Text="Create a desktop shortcut"/>
                <Control Id="MaintenanceNote"
                    Type="Text"
                    X="25"
                    Y="207"
                    Width="320"
                    Height="18"
                    NoPrefix="yes"
                    Text="You can change these options later by running the installer again."/>
            </Dialog>

            <Publish Dialog="BrowseDlg"
                Control="OK"
                Event="DoAction"
                Value="WixUIValidatePath"
                Order="3">1</Publish>
            <Publish Dialog="BrowseDlg"
                Control="OK"
                Event="SpawnDialog"
                Value="InvalidDirDlg"
                Order="4"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>

            <Publish Dialog="ExitDialog"
                Control="Finish"
                Event="EndDialog"
                Value="Return"
                Order="999">1</Publish>

            <Publish Dialog="WelcomeDlg"
                Control="Next"
                Event="NewDialog"
                Value="LicenseAgreementDlg">NOT Installed</Publish>
            <Publish Dialog="WelcomeDlg"
                Control="Next"
                Event="NewDialog"
                Value="VerifyReadyDlg">Installed AND PATCH</Publish>

            <Publish Dialog="LicenseAgreementDlg"
                Control="Back"
                Event="NewDialog"
                Value="WelcomeDlg">1</Publish>
            <Publish Dialog="LicenseAgreementDlg"
                Control="Next"
                Event="NewDialog"
                Value="InstallDirDlg">LicenseAccepted = "1"</Publish>

            <Publish Dialog="InstallDirDlg"
                Control="Back"
                Event="NewDialog"
                Value="LicenseAgreementDlg">1</Publish>
            <Publish Dialog="InstallDirDlg"
                Control="Next"
                Event="SetTargetPath"
                Value="[WIXUI_INSTALLDIR]"
                Order="1">1</Publish>
            <Publish Dialog="InstallDirDlg"
                Control="Next"
                Event="DoAction"
                Value="WixUIValidatePath"
                Order="2">NOT WIXUI_DONTVALIDATEPATH</Publish>
            <Publish Dialog="InstallDirDlg"
                Control="Next"
                Event="SpawnDialog"
                Value="InvalidDirDlg"
                Order="3"><![CDATA[NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID<>"1"]]></Publish>
            <Publish Dialog="InstallDirDlg"
                Control="Next"
                Event="NewDialog"
                Value="VnmTerminalOptionsDlg"
                Order="4">WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID="1"</Publish>
            <Publish Dialog="InstallDirDlg"
                Control="ChangeFolder"
                Property="_BrowseProperty"
                Value="[WIXUI_INSTALLDIR]"
                Order="1">1</Publish>
            <Publish Dialog="InstallDirDlg"
                Control="ChangeFolder"
                Event="SpawnDialog"
                Value="BrowseDlg"
                Order="2">1</Publish>

            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Back"
                Event="NewDialog"
                Value="MaintenanceTypeDlg"
                Order="1">Installed</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Back"
                Event="NewDialog"
                Value="InstallDirDlg"
                Order="2">NOT Installed</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="AddLocal"
                Value="VnmTerminalStartMenuFeature"
                Order="1">VnmTerminalStartMenuSelected = 1</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="Remove"
                Value="VnmTerminalStartMenuFeature"
                Order="2">NOT VnmTerminalStartMenuSelected</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="AddLocal"
                Value="VnmTerminalSystemPathFeature"
                Order="3">VnmTerminalSystemPathSelected = 1</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="Remove"
                Value="VnmTerminalSystemPathFeature"
                Order="4">NOT VnmTerminalSystemPathSelected</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="AddLocal"
                Value="VnmTerminalDesktopFeature"
                Order="5">VnmTerminalDesktopSelected = 1</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="Remove"
                Value="VnmTerminalDesktopFeature"
                Order="6">NOT VnmTerminalDesktopSelected</Publish>
            <Publish Dialog="VnmTerminalOptionsDlg"
                Control="Next"
                Event="NewDialog"
                Value="VerifyReadyDlg"
                Order="7">1</Publish>

            <Publish Dialog="VerifyReadyDlg"
                Control="Back"
                Event="NewDialog"
                Value="VnmTerminalOptionsDlg"
                Order="1">NOT Installed OR WixUI_InstallMode = "Change"</Publish>
            <Publish Dialog="VerifyReadyDlg"
                Control="Back"
                Event="NewDialog"
                Value="MaintenanceTypeDlg"
                Order="2">Installed AND NOT PATCH</Publish>
            <Publish Dialog="VerifyReadyDlg"
                Control="Back"
                Event="NewDialog"
                Value="WelcomeDlg"
                Order="3">Installed AND PATCH</Publish>

            <Publish Dialog="MaintenanceWelcomeDlg"
                Control="Next"
                Event="NewDialog"
                Value="MaintenanceTypeDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg"
                Control="ChangeButton"
                Event="NewDialog"
                Value="VnmTerminalOptionsDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg"
                Control="RepairButton"
                Event="NewDialog"
                Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg"
                Control="RemoveButton"
                Event="NewDialog"
                Value="VerifyReadyDlg">1</Publish>
            <Publish Dialog="MaintenanceTypeDlg"
                Control="Back"
                Event="NewDialog"
                Value="MaintenanceWelcomeDlg">1</Publish>
        </UI>

        <UIRef Id="WixUI_Common"/>
    </Fragment>
</Wix>
